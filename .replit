modules = ["nodejs-20"]

[workflows]
runButton = "run app"

[[workflows.workflow]]
name = "Run Dev"
author = 2636792
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm install"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run start -- --host 0.0.0.0"

[[workflows.workflow]]
name = "Sh"
mode = "sequential"
author = 2636792

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cat package.json"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "ls"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Run Dev"

[[workflows.workflow]]
name = "run app"
mode = "sequential"
author = 2636792

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"

[[workflows.workflow]]
name = "Deploy to Production"
author = 2636792
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run build"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run preview -- --host 0.0.0.0"

[[ports]]
localPort = 3000
externalPort = 3000
exposeLocalhost = true

[[ports]]
localPort = 3001
externalPort = 80
exposeLocalhost = true

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "npm run preview -- --host 0.0.0.0"]
build = ["sh", "-c", "npm run build"]
